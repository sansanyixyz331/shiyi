+    // ---------------------------------------------------------------- 拾意的"嘴巴"
+    private android.speech.tts.TextToSpeech speech;
+    private boolean speechReady;
+    private String pendingSpeech;
+    /// Speak `text` through Android's own TextToSpeech engine: the engine owns
+    /// the audio (in this process), the app renders nothing and holds no model.
+    /// The engine initializes on first use; a queued utterance waits for onInit.
+    private void speakText(final String text) {
+        if(text==null) return;
+        final String spoken=text.trim();
+        if(spoken.isEmpty()) return;
+        activity.runOnUiThread(() -> {
+            if(speech==null) {
+                speech=new android.speech.tts.TextToSpeech(activity,status -> {
+                    speechReady=(status==android.speech.tts.TextToSpeech.SUCCESS);
+                    if(speechReady&&pendingSpeech!=null) {
+                        String queued=pendingSpeech;pendingSpeech=null;
+                        speech.speak(queued,android.speech.tts.TextToSpeech.QUEUE_ADD,null,"octos-"+System.nanoTime());
+                    }
+                });
+            }
+            if(speechReady) speech.speak(spoken,android.speech.tts.TextToSpeech.QUEUE_ADD,null,"octos-"+System.nanoTime());
+            else pendingSpeech=spoken;
+        });
     }
