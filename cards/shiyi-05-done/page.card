# ledger shiyi-05-done@0.2.0
# level: L0
# profile: ui/l0
# model: shiyi
#
# 拾意 · Pickup — screen 5 of 5: DONE.
#
# A receipt, not a celebration — and an honest one. The three lines are split
# by what actually happened: the first names the one thing that was really
# written to disk (and where), the other two say plainly that nothing was
# moved. Earlier drafts read "trip scheduled / calendar added / reminder set"
# — none of which was true, so they are gone; a receipt that lists work you
# did not do is worse than no receipt. What is NOT here matters too: no score,
# no streak, no "you saved 12 minutes".
#
# Screens are separate cards; see shiyi-01-read for why.

theme light

state act_enabled { shape: bool, initial: true }

# ── copy ─────────────────────────────────────────────────────────────────────
copy eyebrow { class: vocabulary, en: "拾意 · 第五步 · 完成", zh: "拾意 · 第五步 · 完成" }
copy heading { class: vocabulary, en: "记下了。别的没动，等你点头", zh: "记下了。别的没动，等你点头" }

copy r1 { class: vocabulary, en: "写了记忆 · 去深圳默认早班，从家里出发", zh: "写了记忆 · 去深圳默认早班，从家里出发" }
copy r2 { class: vocabulary, en: "行程没动 · 周三那班只是方案里的样例", zh: "行程没动 · 周三那班只是方案里的样例" }
copy r3 { class: vocabulary, en: "日历与提醒没动 · 没碰系统", zh: "日历与提醒没动 · 没碰系统" }

copy foot { class: vocabulary, en: "只有第一行真写进去了，后两行一个字没动。", zh: "只有第一行真写进去了，后两行一个字没动。" }

copy act_again { class: vocabulary, en: "重开一条", zh: "重开一条" }
copy act_open  { class: vocabulary, en: "看行程", zh: "看行程" }

# ── components ───────────────────────────────────────────────────────────────
component Page(instance: text) {
  view Kit(component: "page", instance: instance) { slot }
}
component Slab(instance: text) {
  view Kit(component: "band", instance: instance) { slot }
}
component Eyebrow(instance: text, text: text) {
  view Kit(component: "eyebrow", instance: instance, text: text)
}
component Heading(instance: text, text: text) {
  view Kit(component: "heading", instance: instance, text: text)
}
component Line(instance: text, text: text) {
  view Kit(component: "row", instance: instance, text: text)
}
component Note(instance: text, text: text) {
  view Kit(component: "note", instance: instance, text: text)
}
component Action(instance: text) {
  view Kit(component: "action", instance: instance) { slot }
}
component ActionFill(instance: text) {
  view Kit(component: "action_fill", instance: instance) { slot }
}
component ActionGhost(instance: text) {
  view Kit(component: "action_ghost", instance: instance) { slot }
}
component ActionControl(instance: text, enabled: bool) {
  view Kit(component: "action_control", instance: instance, enabled: enabled)
}
component ActionLabel(instance: text, text: text) {
  view Kit(component: "action_label", instance: instance, text: text)
}
component GhostLabel(instance: text, text: text) {
  view Kit(component: "ghost_label", instance: instance, text: text)
}

# ── view ─────────────────────────────────────────────────────────────────────
view root Page(instance: "page") {
  Eyebrow(instance: "eyebrow", text: copy.eyebrow)
  Heading(instance: "heading", text: copy.heading)

  Slab(instance: "receipt_band") {
    Line(instance: "r1", text: copy.r1)
    Line(instance: "r2", text: copy.r2)
    Line(instance: "r3", text: copy.r3)
  }

  Note(instance: "foot", text: copy.foot)

  Action(instance: "action_again") {
    ActionGhost(instance: "action_again_bg") {

    }
    ActionControl(instance: "action_again_ctl", enabled: act_enabled)
    GhostLabel(instance: "action_again_lbl", text: copy.act_again)
  }
  Action(instance: "action_open") {
    ActionFill(instance: "action_open_bg") {

    }
    ActionControl(instance: "action_open_ctl", enabled: act_enabled)
    ActionLabel(instance: "action_open_lbl", text: copy.act_open)
  }
}
