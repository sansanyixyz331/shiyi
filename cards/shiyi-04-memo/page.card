# ledger shiyi-04-memo@0.2.1
# level: L0
# profile: ui/l0
# model: shiyi
#
# 拾意 · Pickup — screen 4 of 5: REMEMBER.
#
# What is about to be kept is shown as a change to what is already kept — old
# above, new below, both readable — rather than as a success message. A memory
# the user cannot inspect is a memory they cannot correct, and this screen
# exists mainly so the second one stays possible.
#
# Screens are separate cards; see shiyi-01-read for why.

theme light

state act_enabled { shape: bool, initial: true }

# ── copy ─────────────────────────────────────────────────────────────────────
copy eyebrow { class: vocabulary, en: "拾意 · 第四步 · 记忆", zh: "拾意 · 第四步 · 记忆" }
copy heading { class: vocabulary, en: "这件事，往后按这样办", zh: "这件事，往后按这样办" }

copy old_tag { class: vocabulary, en: "原来记着的", zh: "原来记着的" }
copy old_val { class: vocabulary, en: "去深圳，坐高铁不坐飞机。", zh: "去深圳，坐高铁不坐飞机。" }

copy new_tag { class: vocabulary, en: "这次加上", zh: "这次加上" }
copy new_val { class: vocabulary, en: "周三去深圳，默认早班，从家里出发。", zh: "周三去深圳，默认早班，从家里出发。" }

copy foot    { class: vocabulary, en: "下次你说“去深圳”，我就按这个来。想改随时说。", zh: "下次你说“去深圳”，我就按这个来。想改随时说。" }

copy act_skip { class: vocabulary, en: "这次别记", zh: "这次别记" }
copy act_keep { class: vocabulary, en: "记下", zh: "记下" }

# ── components ───────────────────────────────────────────────────────────────
component Page(instance: text) {
  view Kit(component: "page", instance: instance) { slot }
}
component Slab(instance: text) {
  view Kit(component: "band", instance: instance) { slot }
}
component SlabSoft(instance: text) {
  view Kit(component: "band_soft", instance: instance) { slot }
}
component Eyebrow(instance: text, text: text) {
  view Kit(component: "eyebrow", instance: instance, text: text)
}
component Heading(instance: text, text: text) {
  view Kit(component: "heading", instance: instance, text: text)
}
component Line(instance: text, text: text) {
  view Kit(component: "row", instance: instance, text: text)
}
component Note(instance: text, text: text) {
  view Kit(component: "note", instance: instance, text: text)
}
component Action(instance: text) {
  view Kit(component: "action", instance: instance) { slot }
}
component ActionFill(instance: text) {
  view Kit(component: "action_fill", instance: instance) { slot }
}
component ActionGhost(instance: text) {
  view Kit(component: "action_ghost", instance: instance) { slot }
}
component ActionControl(instance: text, enabled: bool) {
  view Kit(component: "action_control", instance: instance, enabled: enabled)
}
component ActionLabel(instance: text, text: text) {
  view Kit(component: "action_label", instance: instance, text: text)
}
component GhostLabel(instance: text, text: text) {
  view Kit(component: "ghost_label", instance: instance, text: text)
}

# ── view ─────────────────────────────────────────────────────────────────────
view root Page(instance: "page") {
  Eyebrow(instance: "eyebrow", text: copy.eyebrow)
  Heading(instance: "heading", text: copy.heading)

  Slab(instance: "old_band") {
    Note(instance: "old_tag", text: copy.old_tag)
    Line(instance: "old_val", text: copy.old_val)
  }
  SlabSoft(instance: "new_band") {
    Note(instance: "new_tag", text: copy.new_tag)
    Line(instance: "new_val", text: copy.new_val)
  }

  Note(instance: "foot", text: copy.foot)

  Action(instance: "action_skip") {
    ActionGhost(instance: "action_skip_bg") {

    }
    ActionControl(instance: "action_skip_ctl", enabled: act_enabled)
    GhostLabel(instance: "action_skip_lbl", text: copy.act_skip)
  }
  Action(instance: "action_keep") {
    ActionFill(instance: "action_keep_bg") {

    }
    ActionControl(instance: "action_keep_ctl", enabled: act_enabled)
    ActionLabel(instance: "action_keep_lbl", text: copy.act_keep)
  }
}
