# ledger shiyi-01-read@0.2.2
# level: L0
# profile: ui/l0
# model: shiyi
#
# 拾意 · Pickup — screen 1 of 5: READ.
#
# One message the user already sent. This screen says back only what was taken
# out of it, and where each piece came from, then asks one question: is this
# the thing? Nothing is decided here and nothing is guessed — the two facts
# that are NOT in the message are named as open, not filled in.
#
# Screens are separate cards, not states inside one card, because the reference
# host's card path (kit_pack) carries no tap events: a Kit node cannot declare
# on_tap, so no card here can move itself to the next screen. What moves the
# app forward is the Agent, which reads the action the tapped button writes
# into service-actions.json and hands back the next card. That is also the
# shape the official aircon app uses — 12 screens, 12 cards, actions declared
# beside them.
#
# No `source` is declared, on purpose. L0 sources name catalogued capabilities
# (weather, quotes, places…); there is no "read a chat message" capability,
# because reading the message is the Agent's job and the card is what the
# Agent produces. So every fact printed here is declared `copy`, and each one
# says where it came from — the no-facts rule honoured, not dodged.

theme light

state act_enabled { shape: bool, initial: true }

# What the device assistant (the host's local octos kernel) says is still
# missing. `read` is the target of `octos.turn.start` in bindings.json: the
# host writes each service result as data[target] = {"is_ok": …, "data": …}.
# Seeded in page.data.json as "not answered yet", so the guard below is false
# until a real reply lands — the card never depends on a call succeeding.
state read { shape: text }

# ── copy ─────────────────────────────────────────────────────────────────────
copy eyebrow   { class: vocabulary, en: "拾意 · 第一步 · 识别", zh: "拾意 · 第一步 · 识别" }
copy heading   { class: vocabulary, en: "从你发过的话里，读出了一个安排", zh: "从你发过的话里，读出了一个安排" }

copy quote     { class: user-copy,  en: "「下周三我得去趟深圳」", zh: "「下周三我得去趟深圳」" }
copy quote_src { class: vocabulary, en: "家庭群 · 9月24日 21:14 · 消息原文", zh: "家庭群 · 9月24日 21:14 · 消息原文" }

copy f_when    { class: vocabulary, en: "时间 · 下周三 9月30日 · 出自原文", zh: "时间 · 下周三 9月30日 · 出自原文" }
copy f_where   { class: vocabulary, en: "地点 · 广东深圳 · 出自原文", zh: "地点 · 广东深圳 · 出自原文" }
copy f_kind    { class: vocabulary, en: "类型 · 出行安排 · 识别所得", zh: "类型 · 出行安排 · 识别所得" }
copy f_open    { class: vocabulary, en: "还没定：坐哪班、几点。这一步我不猜。", zh: "还没定：坐哪班、几点。这一步我不猜。" }

# Both sources are stated, never merged: time/place/type are read by the app's
# local rules, while "what is still missing" is supplied by the device
# assistant when one is available — and stays the local rule's line when it is
# not. Which one ran is printed, not implied.
copy memo_lbl  { class: vocabulary, en: "从本机记忆里读到：你坐高铁，不坐飞机。", zh: "从本机记忆里读到：你坐高铁，不坐飞机。" }
copy memo_eff  { class: vocabulary, en: "所以往下只会给你高铁方案。", zh: "所以往下只会给你高铁方案。" }

# Where this reading came from. The time/place/type above were read by the app's
# local rules; the "what's still missing" line below is supplemented by the
# device assistant when one is available, and falls back to the local rule when
# it is not. Which one ran is part of the record, so it is printed, not implied.
copy f_src     { class: vocabulary, en: "识别来源 · 本地规则（设备助手可用时另加一行）", zh: "识别来源 · 本地规则（设备助手可用时另加一行）" }

copy act_yes   { class: vocabulary, en: "对，就是这件事", zh: "对，就是这件事" }
copy act_fix   { class: vocabulary, en: "不对，改一下", zh: "不对，改一下" }

# ── components ───────────────────────────────────────────────────────────────
component Page(instance: text) {
  view Kit(component: "page", instance: instance) { slot }
}
component Slab(instance: text) {
  view Kit(component: "band", instance: instance) { slot }
}
component Hairline(instance: text) {
  view Kit(component: "hairline", instance: instance)
}
component Eyebrow(instance: text, text: text) {
  view Kit(component: "eyebrow", instance: instance, text: text)
}
component Heading(instance: text, text: text) {
  view Kit(component: "heading", instance: instance, text: text)
}
component Quote(instance: text, text: text) {
  view Kit(component: "quote", instance: instance, text: text)
}
component Source(instance: text, text: text) {
  view Kit(component: "source", instance: instance, text: text)
}
component Line(instance: text, text: text) {
  view Kit(component: "row", instance: instance, text: text)
}
component Note(instance: text, text: text) {
  view Kit(component: "note", instance: instance, text: text)
}
component Action(instance: text) {
  view Kit(component: "action", instance: instance) { slot }
}
component ActionFill(instance: text) {
  view Kit(component: "action_fill", instance: instance) { slot }
}
component ActionGhost(instance: text) {
  view Kit(component: "action_ghost", instance: instance) { slot }
}
component ActionControl(instance: text, enabled: bool) {
  view Kit(component: "action_control", instance: instance, enabled: enabled)
}
component ActionLabel(instance: text, text: text) {
  view Kit(component: "action_label", instance: instance, text: text)
}
component GhostLabel(instance: text, text: text) {
  view Kit(component: "ghost_label", instance: instance, text: text)
}

# ── view ─────────────────────────────────────────────────────────────────────
view root Page(instance: "page") {
  Eyebrow(instance: "eyebrow", text: copy.eyebrow)
  Heading(instance: "heading", text: copy.heading)

  # What was actually said: the user's own words, quoted, with where they came
  # from — so the reading can be checked against its source.
  Slab(instance: "quote_band") {
    Quote(instance: "quote", text: copy.quote)
    Source(instance: "quote_src", text: copy.quote_src)
  }

  Hairline(instance: "rule_1")

  # What was taken out, each line saying whether it is the message's own words
  # or something this app worked out.
  Line(instance: "row_when",  text: copy.f_when)
  Line(instance: "row_where", text: copy.f_where)
  Line(instance: "row_kind",  text: copy.f_kind)
  # The local rule's answer: always rendered. The card depends on no service
  # succeeding, so a host with no assistant shows this screen unchanged.
  Note(instance: "row_open",  text: copy.f_open)

  # The device assistant's answer, rendered only when it actually replied
  # (read.is_ok). On a failed or unconfigured turn this guard is false and the
  # path is never evaluated, so a dead assistant cannot break the card.
  when read.is_ok { Note(instance: "row_ai", text: read.data.text) }

  # The reading's source line: the record of who did this step, printed.
  Note(instance: "row_src",   text: copy.f_src)

  Hairline(instance: "rule_2")

  # The long-term rule this app already remembers, stated before it is used.
  Note(instance: "memo_lbl", text: copy.memo_lbl)
  Note(instance: "memo_eff", text: copy.memo_eff)

  # One question, two answers, neither of them silent.
  Action(instance: "action_yes") {
    ActionFill(instance: "action_yes_bg") {

    }
    ActionControl(instance: "action_yes_ctl", enabled: act_enabled)
    ActionLabel(instance: "action_yes_lbl", text: copy.act_yes)
  }
  Action(instance: "action_fix") {
    ActionGhost(instance: "action_fix_bg") {

    }
    ActionControl(instance: "action_fix_ctl", enabled: act_enabled)
    GhostLabel(instance: "action_fix_lbl", text: copy.act_fix)
  }
}
