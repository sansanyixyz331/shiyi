+    /// 便携包把应用放在 <exe 目录>/app/ 下：打开导入表单时自动填好路径，用户不必手打。
+    fn prefill_bundle_path(&mut self, cx: &mut Cx) {
+        // 有值且仍然有效（指向真正的应用包）⇒ 保留；否则按 exe 所在目录重填。
+        // —— 便携包被拷到别的电脑 / 别的目录时旧路径会失效，必须能自愈。
+        let cur = self.view.text_input(cx, ids!(import_form.path)).text();
+        let cur = cur.trim().to_string();
+        if !cur.is_empty() && std::path::Path::new(&cur).join("manifest.json").is_file() {
+            return;
+        }
+        let Some(exe) = std::env::current_exe().ok() else { return };
+        let Some(dir) = exe.parent() else { return };
+        let mut found: Option<PathBuf> = None;
+        if let Ok(entries) = std::fs::read_dir(dir.join("app")) {
+            for entry in entries.flatten() {
+                let p = entry.path();
+                if p.is_dir() && p.join("manifest.json").is_file() {
+                    found = Some(p);
+                    break;
+                }
+            }
+        }
+        if let Some(p) = found {
+            let s = p.to_string_lossy().to_string();
+            let s = s.strip_prefix(r"\\?\").unwrap_or(&s).to_string();
+            self.view.text_input(cx, ids!(import_form.path)).set_text(cx, &s);
+        }
+    }
