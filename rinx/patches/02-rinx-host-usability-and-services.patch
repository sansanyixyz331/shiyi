@@ -1,8 +1,14 @@
 package org.octosense.rinx;
 
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
 import android.content.Intent;
 import android.content.ComponentCallbacks;
+import android.content.Context;
+import android.content.pm.PackageManager;
 import android.content.res.Configuration;
+import android.os.Build;
 import android.util.Log;
 
 import java.lang.reflect.Field;
@@ -55,7 +61,96 @@ public final class MakepadAppExtension implements MakepadActivity.ApplicationExt
             mActivity.moveTaskToBack(true);
         }
         if ("rinx.appearance".equals(channel)) { publishAppearance(); }
+        // Added 2026-10-11: Rust 侧发 "rinx.notify" 即弹一条安卓系统通知（到点提醒用）。
+        if ("rinx.notify".equals(channel)) { showNotification(payload); }
+        // Added 2026-10-11: Rust 侧发 "rinx.speak" 即用系统 TTS 念出来（提醒"会说话"）。
+        if ("rinx.speak".equals(channel)) { speakText(payload); }
     }
+
+    /**
+     * Added 2026-10-11: 用安卓系统通知弹一条提醒。
+     *
+     * <p>payload 形如 {@code {"title":"…","text":"…"}}；解析不了就把整串当正文。
+     * 安卓 13+ 需要运行时申请 POST_NOTIFICATIONS（清单里已声明）；渠道一次建好，
+     * 之后重复调用只更新同一条通知。
+     */
+    @SuppressWarnings("deprecation")
+    private void showNotification(String payload) {
+        String title = "Rinx";
+        String text = payload == null ? "" : payload;
+        try {
+            org.json.JSONObject o = new org.json.JSONObject(text);
+            title = o.optString("title", title);
+            text = o.optString("text", text);
+        } catch (Exception ignored) {
+            // Not JSON: show the payload as the body.
+        }
+        NotificationManager nm =
+            (NotificationManager) mActivity.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (nm == null) { return; }
+        final String channelId = "rinx.remind";
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            NotificationChannel ch = new NotificationChannel(
+                channelId, "Rinx 提醒", NotificationManager.IMPORTANCE_HIGH);
+            nm.createNotificationChannel(ch);
+        }
+        if (Build.VERSION.SDK_INT >= 33
+            && mActivity.checkSelfPermission("android.permission.POST_NOTIFICATIONS")
+               != PackageManager.PERMISSION_GRANTED) {
+            mActivity.requestPermissions(
+                new String[] {"android.permission.POST_NOTIFICATIONS"}, 9001);
+        }
+        Notification.Builder builder = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
+            ? new Notification.Builder(mActivity, channelId)
+            : new Notification.Builder(mActivity);
+        Notification n = builder
+            .setSmallIcon(android.R.drawable.ic_dialog_info)
+            .setContentTitle(title)
+            .setContentText(text)
+            .setStyle(new Notification.BigTextStyle().bigText(text))
+            .setAutoCancel(true)
+            .build();
+        nm.notify(9001, n);
+    }
+    // ---------------------------------------------------------------- 提醒的"嘴巴"
+    /**
+     * Added 2026-10-11: 用安卓自带 TextToSpeech 念一句提醒。
+     *
+     * <p>payload 可以是纯文本，也可以是 {@code {"text":"…"}} 的 JSON；两者都吃。
+     * 引擎在本进程持有音频，应用不渲染、不持模型。首次调用时引擎异步初始化，
+     * 期间来的句子先排队（{@code pendingSpeech}），onInit 后补念。
+     */
+    private android.speech.tts.TextToSpeech speech;
+    private boolean speechReady;
+    private String pendingSpeech;
+
+    private void speakText(String payload) {
+        if (payload == null) { return; }
+        String spoken = payload;
+        try {
+            org.json.JSONObject o = new org.json.JSONObject(payload);
+            spoken = o.optString("text", payload);
+        } catch (Exception ignored) { }
+        final String text = spoken == null ? "" : spoken.trim();
+        if (text.isEmpty()) { return; }
+        mActivity.runOnUiThread(() -> {
+            if (speech == null) {
+                speech = new android.speech.tts.TextToSpeech(mActivity, status -> {
+                    speechReady = (status == android.speech.tts.TextToSpeech.SUCCESS);
+                    if (speechReady && pendingSpeech != null) {
+                        String queued = pendingSpeech; pendingSpeech = null;
+                        speech.speak(queued, android.speech.tts.TextToSpeech.QUEUE_ADD, null, "rinx-" + System.nanoTime());
+                    }
+                });
+            }
+            if (speechReady) {
+                speech.speak(text, android.speech.tts.TextToSpeech.QUEUE_ADD, null, "rinx-" + System.nanoTime());
+            } else {
+                pendingSpeech = text;
+            }
+        });
+    }
+
     @Override public void onResume() { publishAppearance(); }
     @Override public void onPause() {}
     @Override public void onIntent(Intent intent) {}
