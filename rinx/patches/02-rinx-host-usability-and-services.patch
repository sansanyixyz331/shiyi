+/// Added 2026-10-11: 桌面发声 —— 用操作系统自己的 TTS 念一句话。
+///
+/// 与手机一致：**作品只说文本、宿主用系统语音**。手机走安卓 `TextToSpeech`，
+/// 桌面（Windows）走系统自带 `System.Speech`。念的过程在 worker 线程里，
+/// 绝不占 UI 线程（官方语音库同样要求 "never the UI thread"）。
+///
+/// 文本用 `-EncodedCommand`（UTF-16LE + base64）整段托给 PowerShell：
+/// 绕开 Windows 命令行的编码问题，中文不会变成问号。
+#[cfg(target_os = "windows")]
+fn desktop_speak(text: &str) {
+    use std::os::windows::process::CommandExt;
+    const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+    let safe = text.replace('\'', "''");
+    let script = format!(
+        "Add-Type -AssemblyName System.Speech; \
+         $s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \
+         $s.Speak('{safe}')"
+    );
+    let encoded = ps_utf16_base64(&script);
+    std::thread::spawn(move || {
+        let mut cmd = std::process::Command::new("powershell");
+        cmd.args(["-NoProfile", "-NonInteractive", "-EncodedCommand", &encoded])
+            .stdin(std::process::Stdio::null())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::piped())
+            .creation_flags(CREATE_NO_WINDOW);
+        // 诊断（worker 线程，不动 UI）：把退出码与 stderr 记下来 ——
+        // "进程起来了"不等于"真出声"，这条日志才是"桌面到底说没说"的判据。
+        match cmd.output() {
+            Ok(out) if out.status.success() => {
+                log!("desktop_speak: 系统 TTS 已念完（退出码 0）");
+            }
+            Ok(out) => {
+                let err = String::from_utf8_lossy(&out.stderr);
+                let brief: String = err.chars().take(300).collect();
+                log!("desktop_speak: 系统 TTS 退出码 {:?} · stderr={brief}", out.status.code());
+            }
+            Err(e) => log!("desktop_speak: 起 powershell 失败：{e}"),
+        }
+    });
+}
