+    /// joined rooms, so a user picks a room instead of pasting a room id.
+    fn fill_import_rooms(&mut self, cx: &mut Cx) {
+        self.import_rooms.clear();
+        self.import_rooms.push(String::new());
+        let mut joined: Vec<(String, String)> = crate::sliding_sync::get_client()
+            .map(|c| {
+                c.joined_rooms()
+                    .into_iter()
+                    .filter(|r| !r.is_space())
+                    // 跟首页那个聊天列表保持一致：**被隐藏的聊天不列出来**
+                    //（否则会出现"首页只有 3 个、这里却列 6 个"的对不上）。
+                    .filter(|r| !crate::home::chat_actions::is_hidden(r.room_id()))
+                    .map(|r| {
+                        let name = r
+                            .cached_display_name()
+                            .map(|s| s.to_string())
+                            .or_else(|| r.name())
+                            .unwrap_or_else(|| r.room_id().to_string());
+                        (name, r.room_id().to_string())
+                    })
+                    .collect()
+            })
+            .unwrap_or_default();
+        joined.sort_by(|a, b| a.0.to_lowercase().cmp(&b.0.to_lowercase()));
+        let mut labels: Vec<String> = vec!["不读取任何聊天 / No conversation access".to_string()];
+        for (name, id) in joined {
+            labels.push(name);
+            self.import_rooms.push(id);
+        }
+        let room = self.view.drop_down(cx, ids!(run_room));
+        room.set_labels(cx, labels);
+        // Default to the first real conversation: a user should never have to pick
+        // a room just to see the app work. The dropdown stays available to switch.
+        let default_index = if self.import_rooms.len() > 1 { 1 } else { 0 };
+        room.set_selected_item(cx, default_index);
+    }
+    /// 递归复制目录（应用包里都是小文件，直接拷）。
+    fn copy_tree(src: &std::path::Path, dst: &std::path::Path) -> Result<(), String> {
+        std::fs::create_dir_all(dst).map_err(|e| e.to_string())?;
+        for entry in std::fs::read_dir(src).map_err(|e| e.to_string())? {
+            let entry = entry.map_err(|e| e.to_string())?;
+            let path = entry.path();
+            let target = dst.join(entry.file_name());
+            if path.is_dir() {
+                Self::copy_tree(&path, &target)?;
+            } else {
+                std::fs::copy(&path, &target).map_err(|e| e.to_string())?;
+            }
+        }
+        Ok(())
+    }
+
+    /// 宿主给应用的快照是「用完即删」的（`Package` 一释放就删掉那个目录），
+    /// 所以列表扫 `imports/` 永远留不住东西。这里把应用固化成**我们自己的持久副本**
+    /// （`miniapps/myapps/<id>/`），列表扫的就是它 —— 导入一次就一直留着。
+    fn persist_import(src: &std::path::Path) -> Result<std::path::PathBuf, String> {
+        let raw = std::fs::read_to_string(src.join("manifest.json")).map_err(|e| e.to_string())?;
+        let manifest: Value = serde_json::from_str(&raw).map_err(|e| e.to_string())?;
+        let id = manifest
+            .get("id")
+            .and_then(|v| v.as_str())
+            .ok_or("manifest.id missing")?
+            .to_owned();
+        let safe: String = id
+            .chars()
+            .map(|c| if c.is_ascii_alphanumeric() || c == '-' || c == '_' || c == '.' { c } else { '_' })
+            .collect();
+        let dst = crate::app_data_dir().join("miniapps/myapps").join(&safe);
+        if std::fs::canonicalize(src).ok() == std::fs::canonicalize(&dst).ok() {
+            return Ok(dst); // 已经在持久目录里了
+        }
+        if dst.join("manifest.json").is_file() {
+            return Ok(dst); // 之前固化过，复用
+        }
+        let _ = std::fs::remove_dir_all(&dst);
+        Self::copy_tree(src, &dst)?;
+        Ok(dst)
+    }
+    /// 扫描已导入的应用，使它们在列表里常驻。我们自己的持久目录优先，
+    /// `imports/` 是宿主的临时快照目录（扫它只为兼容早先版本留下的副本）。
+    fn refresh_imported_apps(&mut self) {
+        let in_use = self.package.as_ref().map(|p| p.root.clone());
+        let mut out: Vec<(String, String, String)> = Vec::new();
+        let mut seen: std::collections::HashSet<String> = std::collections::HashSet::new();
+        let roots = [
+            crate::app_data_dir().join("miniapps/myapps"),
+            crate::app_data_dir().join("miniapps/imports"),
+        ];
+        for dir in roots.iter() {
+            let Ok(entries) = std::fs::read_dir(dir) else { continue };
+            for entry in entries.flatten() {
+                let path = entry.path();
+                if !path.is_dir() {
+                    continue;
+                }
+                let Ok(raw) = std::fs::read_to_string(path.join("manifest.json")) else { continue };
+                let Ok(manifest) = serde_json::from_str::<Value>(&raw) else { continue };
+                let Some(id) = manifest.get("id").and_then(|v| v.as_str()) else { continue };
+                if id == super::palpo::APP_ID {
+                    // Palpo 是内置应用，不是"导入的应用"。宿主每次打开它都会留一份临时
+                    // 快照，进程被强杀时来不及清 —— 顺手清掉（正在用的那份除外）。
+                    if dir.ends_with("imports") && in_use.as_deref() != Some(path.as_path()) {
+                        let _ = std::fs::remove_dir_all(&path);
+                    }
+                    continue;
+                }
+                if !seen.insert(id.to_owned()) {
+                    continue; // 已经有更新的那份了（我的持久目录先扫）
+                }
+                let version = manifest.get("version").and_then(|v| v.as_str()).unwrap_or("");
+                let name = std::fs::read_to_string(path.join("listing.json"))
+                    .ok()
+                    .and_then(|s| serde_json::from_str::<Value>(&s).ok())
+                    .and_then(|l| {
+                        l.get("name")
+                            .or_else(|| l.get("title"))
+                            .and_then(|v| v.as_str())
+                            .map(str::to_owned)
+                    })
+                    .or_else(|| manifest.get("name").and_then(|v| v.as_str()).map(str::to_owned))
+                    .unwrap_or_else(|| id.to_string());
+                let label = if version.is_empty() { name } else { format!("{} {}", name, version) };
+                out.push((id.to_string(), label, path.to_string_lossy().to_string()));
+            }
+        }
+        out.sort_by(|a, b| a.0.cmp(&b.0).then(b.1.cmp(&a.1)));
+        out.dedup_by(|a, b| a.0 == b.0);
+        self.imported_apps = out;
+    }
+
+    /// 打开一个「已导入」的包（来源是 imports 目录，不走内置白名单）。
+    fn open_imported(&mut self, cx: &mut Cx, path: &str) -> Result<(), String> {
+        self.stop(cx);
+        self.package = None;
+        let persisted = Self::persist_import(std::path::Path::new(path))?;
+        let snapshots = crate::app_data_dir().join("miniapps/imports");
+        let package = Package::load_in(&persisted, &snapshots)?;
+        self.show_import(cx);
+        // show_import 已经把下拉填好、并默认选中第一个真实聊天 —— 千万别在这里再
+        // set 成 0（"不读取任何聊天"），否则应用一打开就是"没绑房间"、读不到群消息。
+        self.review_package(cx, package)?;
+        Ok(())
+    }
+
+    /// 点「打开」= **直接进应用**（跳过导入表单）。要改参数/看它申请了哪些能力，
+    /// 点「修改」走 `open_imported()`。
+    fn open_imported_directly(&mut self, cx: &mut Cx, path: &str) -> Result<(), String> {
+        self.stop(cx);
+        self.package = None;
+        // 先固化一份到我们自己的目录（否则跑完一放列表就找不到了）。
+        let persisted = Self::persist_import(std::path::Path::new(path))?;
+        let snapshots = crate::app_data_dir().join("miniapps/imports");
+        let package = Package::load_in(&persisted, &snapshots)?;
