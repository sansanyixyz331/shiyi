+    /// 导入应用的「删除」：点第一下只改成确认态，点第二下才真删。
+    ///
+    /// 删掉的是 imports 目录里该应用的**全部副本**（含异常退出遗留的快照），
+    /// 下次点「导入应用」还能重新导入 —— 所以"不想用了"和"想重新填参数"都有出路。
+    fn request_remove(&mut self, cx: &mut Cx, id: &str, label: &str) {
+        if self.pending_remove.as_deref() != Some(id) {
+            self.pending_remove = Some(id.to_owned());
+            self.notice(
+                cx,
+                &format!("再点一次「确认删除」就会移除 {label}；删掉之后还能重新导入。 / Tap “Confirm” once more to remove {label} — you can import it again later."),
+            );
+            return;
+        }
+        self.pending_remove = None;
+        // 正在跑的就是它：先停下来，文件不被占用才删得掉。
+        if self.package.as_ref().map(|p| p.manifest.id.clone()).as_deref() == Some(id) {
+            self.stop(cx);
+            self.package = None;
+        }
+        // 我们自己的持久目录 + 宿主的临时快照目录，两处都清干净。
+        let dirs = [
+            crate::app_data_dir().join("miniapps/myapps"),
+            crate::app_data_dir().join("miniapps/imports"),
+        ];
+        // 先把要删的目录收集完，再动手删。边枚举边删会让目录迭代提前结束，
+        // 同一个应用的多份副本就会删不干净。
+        let mut targets: Vec<std::path::PathBuf> = Vec::new();
+        for dir in dirs.iter() {
+        if let Ok(entries) = std::fs::read_dir(dir) {
+            for entry in entries.flatten() {
+                let path = entry.path();
+                if !path.is_dir() {
+                    continue;
+                }
+                let Ok(raw) = std::fs::read_to_string(path.join("manifest.json")) else { continue };
+                let Ok(manifest) = serde_json::from_str::<Value>(&raw) else { continue };
+                if manifest.get("id").and_then(|v| v.as_str()) == Some(id) {
+                    targets.push(path);
+                }
+            }
+        }
+        }
+        let mut removed = 0usize;
+        let mut first_error: Option<String> = None;
+        for path in targets {
+            match std::fs::remove_dir_all(&path) {
+                Ok(()) => removed += 1,
+                Err(e) => {
+                    first_error.get_or_insert_with(|| format!("{}: {e}", path.display()));
+                }
+            }
+        }
+        self.refresh_imported_apps();
+        if let Some(error) = first_error {
+            self.notice(cx, &format!("没能删掉 {label}：{error} / Could not remove {label}."));
+        } else if removed > 0 {
+            self.notice(
+                cx,
+                &format!("已移除 {label}。想再用它，点最下面的「导入应用」重新导入即可；参数也重新填。 / Removed {label}. To use it again, tap “Import an app” — you can fill the settings again there."),
+            );
+        } else {
+            self.notice(cx, &format!("没找到 {label} 的文件，可能已经删掉了。 / No files found for {label}."));
+        }
+    }
